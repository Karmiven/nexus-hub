<%- include('../partials/header') %>

<section class="auth-section">
  <div class="auth-card">
    <div class="auth-header">
      <h1 class="auth-title" data-i18n="twofa_title">Two-Factor Authentication</h1>
      <p class="auth-subtitle" data-i18n="twofa_prompt">Enter the 6-digit code from your authenticator app.</p>
    </div>
    <form action="/auth/2fa" method="POST" class="auth-form">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <div class="form-group">
        <label for="code" data-i18n="twofa_enter_code">6-digit code</label>
        <input type="text" id="code" name="code" class="form-input code-input" inputmode="numeric" pattern="[0-9]{6}" maxlength="6" required autocomplete="one-time-code" autofocus>
      </div>
      <button type="submit" class="btn btn-primary btn-block" data-i18n="twofa_verify">Verify</button>
    </form>
  </div>
</section>

<%- include('../partials/footer') %>
