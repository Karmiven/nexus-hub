<%- include('partials/header') %>

<div class="scr-head">
  <div class="grow">
    <div class="scr-eyebrow">// <a href="/servers" class="link-m" data-i18n="back_to_servers">Back to Servers</a></div>
    <h1 class="scr-title"><%= server.name %></h1>
    <p class="scr-sub"><%= server.game %></p>
  </div>
  <span class="mbadge <%= server.status === 'online' ? 'ok' : 'bad' %>" data-i18n="<%= server.status === 'online' ? 'online' : 'offline' %>"><%= server.status === 'online' ? 'Online' : 'Offline' %></span>
</div>

<div class="panel" style="max-width:760px;">
  <span class="panel-corner tl"></span><span class="panel-corner br"></span>
  <% if (server.image) { %>
    <div class="news-thumb has-img" style="min-height:220px; background-image:url('<%= server.image %>'); border-bottom:1px solid var(--border);"></div>
  <% } %>
  <div class="srv-body" style="padding:18px 20px;">
    <% if (server.show_ip_address) { %>
      <div class="addr">
        <code><%= server.ip %>:<%= server.port %></code>
        <% if (user && user.role === 'admin') { %>
          <button type="button" onclick="copyAddr(this)" data-i18n="copy">copy</button>
        <% } %>
      </div>
    <% } %>
    <% if (server.show_player_count && server.status === 'online') { %>
      <div class="pbar">
        <span><%= server.player_count %>/<%= server.max_players %></span>
        <div class="bar"><div class="fill" style="width:<%= server.max_players > 0 ? Math.round(server.player_count / server.max_players * 100) : 0 %>%"></div></div>
      </div>
    <% } %>
    <% if (server.description) { %>
      <div>
        <div class="scr-eyebrow" data-i18n="about_server">About this Server</div>
        <p class="scr-sub" style="margin:0; max-width:none;"><%= server.description %></p>
      </div>
    <% } %>
  </div>
  <div class="srv-foot">
    <span><span data-i18n="last_checked">Checked</span>: <span class="local-time" data-timestamp="<%= server.last_checked %>" data-format="datetime"></span></span>
    <% if (server.redirect_enabled && server.redirect_url) { %>
      <a href="<%= server.redirect_url %>" target="_blank" rel="noopener" class="btn-c">
        <span data-i18n="open_launcher">Open Launcher</span> <i data-lucide="external-link"></i>
      </a>
    <% } %>
  </div>
</div>

<script>
function copyAddr(btn) {
  var code = btn.parentElement.querySelector('code');
  if (!code) return;
  if (navigator.clipboard) navigator.clipboard.writeText(code.textContent).catch(function () {});
  var original = btn.textContent;
  btn.textContent = 'ok ✓';
  setTimeout(function () { btn.textContent = original; }, 1400);
}
</script>

<%- include('partials/footer') %>
