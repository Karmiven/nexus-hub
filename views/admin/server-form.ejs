<%- include('../partials/header') %>

<section class="admin-header">
  <div class="container">
    <h1 class="page-title"><i data-lucide="settings"></i> <span data-i18n="<%= server ? 'admin_edit_server' : 'admin_new_server' %>"><%= server ? 'Редактировать' : 'Новый' %> сервер</span></h1>
    <%- include('../partials/admin-nav', { activeTab: 'servers' }) %>
  </div>
</section>

<section class="section container">
  <div class="form-card">
    <form action="<%= server ? '/admin/servers/' + server.id + '?_csrf=' + csrfToken : '/admin/servers?_csrf=' + csrfToken %>" method="POST" enctype="multipart/form-data" class="admin-form">
      <div class="form-row">
        <div class="form-group">
          <label for="name" data-i18n="admin_server_name">Название сервера *</label>
          <input type="text" id="name" name="name" class="form-input" required value="<%= server ? server.name : '' %>">
        </div>
        <div class="form-group">
          <label for="game" data-i18n="admin_server_game">Игра *</label>
          <input type="text" id="game" name="game" class="form-input" required value="<%= server ? server.game : '' %>" list="gamesList" placeholder="e.g. Minecraft, World of Warcraft">
          <datalist id="gamesList">
            <option value="Minecraft">
            <option value="World of Warcraft">
            <option value="Blade and Soul">
            <option value="Killing Floor 2">
            <option value="Counter-Strike 2">
            <option value="Valheim">
            <option value="ARK: Survival Evolved">
            <option value="Terraria">
          </datalist>
        </div>
      </div>
      <div class="form-row">
        <div class="form-group">
          <label for="ip" data-i18n="admin_server_ip">IP адрес *</label>
          <input type="text" id="ip" name="ip" class="form-input" required value="<%= server ? server.ip : '' %>" placeholder="e.g. 192.168.1.100">
        </div>
        <div class="form-group">
          <label for="port" data-i18n="admin_server_port">Порт *</label>
          <input type="number" id="port" name="port" class="form-input" required value="<%= server ? server.port : '' %>" min="1" max="65535" placeholder="e.g. 25565">
        </div>
      </div>
      <div class="form-row">
        <div class="form-group">
          <label for="description_en" data-i18n="admin_server_desc_en">Description (English)</label>
          <textarea id="description_en" name="description_en" class="form-input form-textarea" rows="4"><%= server ? (server.description_en || '') : '' %></textarea>
        </div>
        <div class="form-group">
          <div class="desc-ru-head">
            <label for="description_ru" data-i18n="admin_server_desc_ru">Description (Russian)</label>
            <button type="button" class="btn btn-xs btn-outline lang-translate-btn" id="translateDescBtn">
              <i data-lucide="languages"></i> <span data-i18n="admin_translate_from_en">Translate from EN</span>
            </button>
          </div>
          <% if (!server) { %>
          <div id="ruDescAutoState" class="lang-auto-state">
            <p class="lang-auto-note" style="margin-top:0;"><i data-lucide="sparkles"></i> <span data-i18n="admin_translate_auto_desc">Russian, Romanian &amp; German are generated automatically from English via DeepL when you save.</span></p>
            <button type="button" class="btn btn-xs btn-outline" id="showRuDescManual">
              <i data-lucide="pencil"></i> <span data-i18n="admin_translate_write_manually">Write manually</span>
            </button>
          </div>
          <% } %>
          <textarea id="description_ru" name="description_ru" class="form-input form-textarea" rows="4" style="<%= server ? '' : 'display:none;' %>"><%= server ? (server.description_ru || '') : '' %></textarea>
        </div>
      </div>
      <% if (server) { %>
      <p class="lang-auto-note" data-i18n="admin_translate_note">Leave blank to auto-translate from English on save. Romanian &amp; German are always generated automatically.</p>
      <% } %>
      <fieldset class="form-fieldset">
        <legend data-i18n="admin_redirect_settings">Настройки редиректа</legend>
        <div class="form-group">
          <label class="checkbox-label">
            <input type="checkbox" name="redirect_enabled" value="1" id="redirectToggle" <%= server && server.redirect_enabled ? 'checked' : '' %>>
            <span data-i18n="admin_redirect_enable">Включить редирект при клике на сервер</span>
          </label>
        </div>
        <div class="form-group" id="redirectUrlGroup">
          <label for="redirect_url" data-i18n="admin_redirect_url">URL редиректа</label>
          <input type="url" id="redirect_url" name="redirect_url" class="form-input" value="<%= server ? server.redirect_url : '' %>" placeholder="https://example.com/launcher">
        </div>
      </fieldset>

      <fieldset class="form-fieldset">
        <legend data-i18n="admin_additional">Дополнительно</legend>
        <div class="form-group">
          <label class="checkbox-label">
            <input type="checkbox" name="show_player_count" value="1" <%= server && server.show_player_count ? 'checked' : '' %>>
            <span data-i18n="admin_show_players">Показывать кол-во игроков (только Minecraft)</span>
          </label>
        </div>
        <div class="form-group">
          <label class="checkbox-label">
            <input type="checkbox" name="show_ip_address" value="1" <%= !server || server.show_ip_address ? 'checked' : '' %>>
            <span data-i18n="admin_show_ip">Показывать IP адрес в списке серверов</span>
          </label>
        </div>
        <div class="form-group">
          <label for="sort_order" data-i18n="admin_sort_order">Порядок сортировки (меньше = выше)</label>
          <input type="number" id="sort_order" name="sort_order" class="form-input" value="<%= server ? server.sort_order : 0 %>" min="0">
        </div>
      </fieldset>

      <div class="form-actions">
        <button type="submit" class="btn btn-primary" data-i18n="<%= server ? 'admin_save_server' : 'admin_add_server_btn' %>"><%= server ? 'Сохранить' : 'Добавить' %> сервер</button>
        <a href="/admin/servers" class="btn btn-outline" data-i18n="cancel">Отмена</a>
      </div>
    </form>
  </div>
</section>

<style>
  .desc-ru-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    margin-bottom: 0.4rem;
  }
  .desc-ru-head label { margin-bottom: 0; }
  .lang-translate-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    white-space: nowrap;
  }
  .lang-translate-btn i { width: 14px; height: 14px; }
  .lang-auto-note {
    margin: -0.25rem 0 1rem;
    font-size: 0.78rem;
    color: var(--text-secondary);
    opacity: 0.85;
    line-height: 1.4;
  }
  .lang-auto-state {
    padding: 1rem;
    border: 1px dashed var(--border);
    border-radius: var(--radius-sm);
    text-align: center;
    margin-bottom: 0.5rem;
  }
  .lang-auto-state .lang-auto-note { margin: 0 0 0.75rem; }
  .lang-auto-state .lang-auto-note i {
    width: 14px;
    height: 14px;
    vertical-align: -2px;
    margin-right: 0.3rem;
  }
</style>

<script nonce="<%= cspNonce %>">
  // Redirect toggle — show the URL field only when redirect is enabled
  var toggle = document.getElementById('redirectToggle');
  var urlGroup = document.getElementById('redirectUrlGroup');
  function updateRedirectVisibility() {
    urlGroup.style.display = toggle.checked ? 'block' : 'none';
  }
  toggle.addEventListener('change', updateRedirectVisibility);
  updateRedirectVisibility();

  // ── Reveal the manual RU description field (toggle or when translating) ──
  function showRuDescManual() {
    var autoState = document.getElementById('ruDescAutoState');
    if (autoState) autoState.style.display = 'none';
    document.getElementById('description_ru').style.display = 'block';
  }
  var showRuDescBtn = document.getElementById('showRuDescManual');
  if (showRuDescBtn) showRuDescBtn.addEventListener('click', showRuDescManual);

  // ── Auto-translate the Russian description from English (DeepL) ──
  var translateBtn = document.getElementById('translateDescBtn');
  if (translateBtn) {
    translateBtn.addEventListener('click', async function () {
      showRuDescManual();
      var src = (document.getElementById('description_en').value || '').trim();
      if (!src) { alert(t('admin_translate_empty')); return; }
      var original = translateBtn.innerHTML;
      translateBtn.disabled = true;
      translateBtn.textContent = t('admin_translate_progress');
      try {
        var csrf = document.querySelector('meta[name="csrf-token"]')?.getAttribute('content');
        var resp = await fetch('/admin/translate', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', 'x-csrf-token': csrf, 'X-Requested-With': 'XMLHttpRequest' },
          body: JSON.stringify({ texts: [src], target: 'ru', source: 'en' }),
          credentials: 'same-origin'
        });
        var newCsrf = resp.headers.get('X-CSRF-Token');
        if (newCsrf) { var m = document.querySelector('meta[name="csrf-token"]'); if (m) m.setAttribute('content', newCsrf); }
        var data = await resp.json();
        if (!data.configured) { alert(t('admin_translate_unconfigured')); return; }
        if (!data.success) { alert(t('admin_translate_failed')); return; }
        if (data.translations[0] != null) document.getElementById('description_ru').value = data.translations[0];
      } catch (err) {
        console.error('translate error:', err);
        alert(t('admin_translate_failed'));
      } finally {
        translateBtn.disabled = false;
        translateBtn.innerHTML = original;
        if (typeof lucide !== 'undefined') lucide.createIcons();
      }
    });
  }
</script>

<%- include('../partials/footer') %>
