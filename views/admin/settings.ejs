<%- include('../partials/header') %>

<section class="admin-header">
  <div class="container">
    <h1 class="page-title"><i data-lucide="settings"></i> <span data-i18n="admin_settings_title">Settings</span></h1>
    <%- include('../partials/admin-nav', { activeTab: 'settings' }) %>
  </div>
</section>

<section class="section container settings-container">
  <div class="form-card settings-card">
    <form action="/admin/settings" method="POST" class="admin-form settings-grid">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <!-- Left column: Site & Appearance -->
      <div class="settings-col-left">
        <fieldset class="form-fieldset">
          <legend><i data-lucide="globe"></i> <span data-i18n="admin_settings_site">Site & Appearance</span></legend>

          <h3 class="settings-subheading"><i data-lucide="panel-top"></i> <span data-i18n="admin_settings_section_top">Branding</span></h3>
          <div class="form-group">
            <label for="site_name" data-i18n="admin_settings_site_name">Site Name</label>
            <input type="text" id="site_name" name="site_name" class="form-input" value="<%= settings.site_name || 'NexusHub' %>">
          </div>
          <div class="form-group">
            <label for="site_description" data-i18n="admin_settings_site_desc">Site Description</label>
            <input type="text" id="site_description" name="site_description" class="form-input" value="<%= settings.site_description || '' %>">
          </div>
          <div class="form-group">
            <label for="navbar_title" data-i18n="admin_settings_nav_title">Navigation Title</label>
            <input type="text" id="navbar_title" name="navbar_title" class="form-input" value="<%= settings.navbar_title || 'NexusHub' %>" maxlength="30">
            <small class="form-hint" data-i18n="admin_settings_nav_hint">Brand name in the sidebar and browser tab.</small>
          </div>
          <div class="form-group">
            <label for="hero_subtitle" data-i18n="admin_settings_overview_subtitle">Overview subtitle</label>
            <input type="text" id="hero_subtitle" name="hero_subtitle" class="form-input" value="<%= settings.hero_subtitle || '' %>" maxlength="120">
            <small class="form-hint" data-i18n="admin_settings_overview_subtitle_hint">Short line under the Overview title on the home screen.</small>
          </div>

          <h3 class="settings-subheading"><i data-lucide="panel-bottom"></i> <span data-i18n="admin_settings_section_bottom">Footer</span></h3>
          <div class="form-group">
            <label for="footer_tagline" data-i18n="admin_settings_footer_tagline">Tagline</label>
            <input type="text" id="footer_tagline" name="footer_tagline" class="form-input" value="<%= settings.footer_tagline || '' %>" maxlength="120" placeholder="Your ultimate gaming server hub.">
          </div>
          <div class="form-group">
            <label for="footer_copyright" data-i18n="admin_settings_footer_copyright">Copyright</label>
            <input type="text" id="footer_copyright" name="footer_copyright" class="form-input" value="<%= settings.footer_copyright || '' %>" maxlength="80" placeholder="<%= settings.navbar_title || 'NexusHub' %>">
            <small class="form-hint" data-i18n="admin_settings_footer_copyright_hint">Text after © 2026. If empty, navigation title is used.</small>
          </div>
        </fieldset>
      </div>

      <!-- Right column: Server & Community -->
      <div class="settings-col-right">
        <fieldset class="form-fieldset">
          <legend><i data-lucide="settings"></i> <span data-i18n="admin_settings_server">Server & Community</span></legend>

          <div class="form-group">
            <label for="site_timezone" data-i18n="admin_settings_timezone">Site Timezone</label>
            <select id="site_timezone" name="site_timezone" class="form-input">
              <%
                var tzData = [
                  { tz: 'Pacific/Midway', offset: -11 },
                  { tz: 'Pacific/Honolulu', offset: -10 },
                  { tz: 'America/Anchorage', offset: -9 },
                  { tz: 'America/Los_Angeles', offset: -8 },
                  { tz: 'America/Denver', offset: -7 },
                  { tz: 'America/Chicago', offset: -6 },
                  { tz: 'America/Mexico_City', offset: -6 },
                  { tz: 'America/Bogota', offset: -5 },
                  { tz: 'America/Lima', offset: -5 },
                  { tz: 'America/New_York', offset: -5 },
                  { tz: 'America/Toronto', offset: -5 },
                  { tz: 'America/Caracas', offset: -4 },
                  { tz: 'America/Santiago', offset: -4 },
                  { tz: 'America/Buenos_Aires', offset: -3 },
                  { tz: 'America/Sao_Paulo', offset: -3 },
                  { tz: 'Atlantic/Azores', offset: -1 },
                  { tz: 'Europe/London', offset: 0 },
                  { tz: 'Europe/Berlin', offset: 1 },
                  { tz: 'Europe/Madrid', offset: 1 },
                  { tz: 'Europe/Paris', offset: 1 },
                  { tz: 'Europe/Rome', offset: 1 },
                  { tz: 'Europe/Warsaw', offset: 1 },
                  { tz: 'Africa/Cairo', offset: 2 },
                  { tz: 'Africa/Johannesburg', offset: 2 },
                  { tz: 'Europe/Athens', offset: 2 },
                  { tz: 'Europe/Bucharest', offset: 2 },
                  { tz: 'Europe/Helsinki', offset: 2 },
                  { tz: 'Europe/Istanbul', offset: 3 },
                  { tz: 'Europe/Kyiv', offset: 2 },
                  { tz: 'Asia/Jerusalem', offset: 2 },
                  { tz: 'Europe/Moscow', offset: 3 },
                  { tz: 'Asia/Riyadh', offset: 3 },
                  { tz: 'Europe/Samara', offset: 4 },
                  { tz: 'Asia/Dubai', offset: 4 },
                  { tz: 'Asia/Tbilisi', offset: 4 },
                  { tz: 'Asia/Baku', offset: 4 },
                  { tz: 'Asia/Karachi', offset: 5 },
                  { tz: 'Asia/Yekaterinburg', offset: 5 },
                  { tz: 'Asia/Kolkata', offset: 5.5 },
                  { tz: 'Asia/Dhaka', offset: 6 },
                  { tz: 'Asia/Almaty', offset: 6 },
                  { tz: 'Asia/Omsk', offset: 6 },
                  { tz: 'Asia/Novosibirsk', offset: 7 },
                  { tz: 'Asia/Bangkok', offset: 7 },
                  { tz: 'Asia/Krasnoyarsk', offset: 7 },
                  { tz: 'Asia/Hong_Kong', offset: 8 },
                  { tz: 'Asia/Shanghai', offset: 8 },
                  { tz: 'Asia/Singapore', offset: 8 },
                  { tz: 'Asia/Irkutsk', offset: 8 },
                  { tz: 'Asia/Seoul', offset: 9 },
                  { tz: 'Asia/Tokyo', offset: 9 },
                  { tz: 'Asia/Yakutsk', offset: 9 },
                  { tz: 'Asia/Vladivostok', offset: 10 },
                  { tz: 'Australia/Sydney', offset: 11 },
                  { tz: 'Asia/Magadan', offset: 11 },
                  { tz: 'Asia/Kamchatka', offset: 12 },
                  { tz: 'Pacific/Auckland', offset: 13 }
                ];
                tzData.sort(function(a, b) { return a.offset - b.offset || a.tz.localeCompare(b.tz); });
                var currentTz = settings.site_timezone || 'Europe/Moscow';
              %>
              <% tzData.forEach(function(item) {
                var sign = item.offset >= 0 ? '+' : '';
                var offsetStr = 'UTC' + sign + (item.offset % 1 === 0 ? item.offset : item.offset.toFixed(1));
                var label = '(' + offsetStr + ') ' + item.tz.replace(/_/g, ' ');
              %>
                <option value="<%= item.tz %>" <%= item.tz === currentTz ? 'selected' : '' %>><%= label %></option>
              <% }); %>
            </select>
            <small class="form-hint" data-i18n="admin_settings_timezone_hint">All dates and times on the site will be displayed in the selected timezone.</small>
          </div>

          <hr style="border: none; border-top: 1px solid var(--border); margin: 1.5rem 0;">

          <div class="form-group">
            <label for="status_check_interval" data-i18n="admin_settings_check_interval">Status check interval (sec.)</label>
            <input type="number" id="status_check_interval" name="status_check_interval" class="form-input" value="<%= settings.status_check_interval || 60 %>" min="10" max="600">
            <small class="form-hint" data-i18n="admin_settings_check_hint">How often to ping servers. Lower = more frequent, but more resources.</small>
          </div>

          <hr style="border: none; border-top: 1px solid var(--border); margin: 1.5rem 0;">

          <div class="form-group">
            <label class="checkbox-label">
              <input type="hidden" name="community_enabled" value="0">
              <input type="checkbox" name="community_enabled" value="1" <%= String(settings.community_enabled) === '1' ? 'checked' : '' %>>
              <span data-i18n="admin_settings_chat_enable">Enable community chat</span>
            </label>
          </div>
          <div class="form-group">
            <label for="max_chat_messages" data-i18n="admin_settings_chat_max">Max chat messages</label>
            <input type="number" id="max_chat_messages" name="max_chat_messages" class="form-input" value="<%= settings.max_chat_messages || 200 %>" min="50" max="1000">
          </div>

          <hr style="border: none; border-top: 1px solid var(--border); margin: 1.5rem 0;">

          <div class="form-group">
            <label class="checkbox-label">
              <input type="hidden" name="registration_enabled" value="0">
              <input type="checkbox" name="registration_enabled" value="1" <%= String(settings.registration_enabled) === '1' ? 'checked' : '' %>>
              <span data-i18n="admin_settings_registration_enable">Enable user registration</span>
            </label>
            <small class="form-hint" data-i18n="admin_settings_registration_hint">If disabled, new users will not be able to register.</small>
          </div>

          <hr style="border: none; border-top: 1px solid var(--border); margin: 1.5rem 0;">

          <div class="form-group">
            <label class="checkbox-label">
              <input type="hidden" name="monitoring_public" value="0">
              <input type="checkbox" name="monitoring_public" value="1" <%= String(settings.monitoring_public) === '1' ? 'checked' : '' %>>
              <span data-i18n="admin_settings_monitoring_enable">Public monitoring page</span>
            </label>
            <small class="form-hint" data-i18n="admin_settings_monitoring_hint">If disabled, the monitoring page is only accessible to staff (admin / GM).</small>
          </div>

          <h3 class="settings-subheading"><i data-lucide="bell"></i> <span data-i18n="admin_settings_discord">Discord notifications</span></h3>
          <div class="form-group">
            <label for="discord_webhook_url" data-i18n="admin_settings_discord_webhook">Webhook URL</label>
            <input type="text" id="discord_webhook_url" name="discord_webhook_url" class="form-input" value="<%= settings.discord_webhook_url || '' %>" placeholder="https://discord.com/api/webhooks/…" autocomplete="off">
            <small class="form-hint" data-i18n="admin_settings_discord_webhook_hint">Server Settings → Integrations → Webhooks in your Discord server. Leave empty to disable.</small>
          </div>
          <div class="form-group">
            <label class="checkbox-label">
              <input type="hidden" name="discord_notify_status" value="0">
              <input type="checkbox" name="discord_notify_status" value="1" <%= String(settings.discord_notify_status) === '1' ? 'checked' : '' %>>
              <span data-i18n="admin_settings_discord_status">Notify when a server goes up or down</span>
            </label>
          </div>
          <div class="form-group">
            <label class="checkbox-label">
              <input type="hidden" name="discord_notify_news" value="0">
              <input type="checkbox" name="discord_notify_news" value="1" <%= String(settings.discord_notify_news) === '1' ? 'checked' : '' %>>
              <span data-i18n="admin_settings_discord_news">Notify when a news article is published</span>
            </label>
          </div>
        </fieldset>
      </div>

      <div class="form-actions settings-full-width">
        <button type="submit" class="btn btn-primary" data-i18n="admin_settings_save">Save Settings</button>
      </div>
    </form>
  </div>
</section>

<%- include('../partials/footer') %>

<style>
  .settings-container { max-width: 1400px; }
  .settings-card { max-width: 100%; }

  .settings-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.5rem;
    align-items: stretch;
  }

  .settings-col-left,
  .settings-col-right {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .settings-col-left > .form-fieldset,
  .settings-col-right > .form-fieldset {
    flex: 1;
    display: flex;
    flex-direction: column;
  }

  .settings-subheading {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    font-weight: 600;
    color: var(--accent);
    font-size: 0.9rem;
    margin: 1.5rem 0 0.75rem;
    padding-bottom: 0.5rem;
    border-bottom: 1px solid var(--border);
  }
  .settings-subheading:first-of-type { margin-top: 0.25rem; }
  .settings-subheading i { width: 1em; height: 1em; }

  .settings-full-width { grid-column: 1 / -1; }

  @media (max-width: 768px) {
    .settings-grid { grid-template-columns: 1fr; }
  }
</style>
