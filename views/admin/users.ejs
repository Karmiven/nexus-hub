<%- include('../partials/header') %>

<section class="admin-header">
  <div class="container">
    <h1 class="page-title"><i data-lucide="settings"></i> <span data-i18n="admin_user_mgmt">Управление пользователями</span></h1>
    <%- include('../partials/admin-nav', { activeTab: 'users' }) %>
  </div>
</section>

<section class="section container">
  <div class="admin-table-wrapper">
    <span class="panel-corner tl"></span><span class="panel-corner br"></span>
    <div class="admin-section-header">
      <h2 data-i18n="admin_users_title">Пользователи</h2>
      <span style="font-size: 0.9rem; color: var(--text-secondary); font-weight: normal;"><%= users.length %> <span data-i18n="admin_users_count">пользователей</span></span>
    </div>

    <div class="table-responsive">
      <table class="data-table table-users">
        <thead>
          <tr>
            <th data-i18n="admin_th_id">ID</th>
            <th data-i18n="admin_th_username">Имя</th>
            <th data-i18n="admin_th_email">Email</th>
            <th data-i18n="admin_th_role">Роль</th>
            <th data-i18n="admin_th_last_login">Посл. вход</th>
            <th data-i18n="admin_th_last_ip">Посл. IP</th>
            <th data-i18n="admin_th_registered">Регистрация</th>
            <th data-i18n="admin_th_actions">Действия</th>
          </tr>
        </thead>
        <tbody>
          <% users.forEach(function(u) { %>
            <tr>
              <td><%= u.id %></td>
              <td><strong><%= u.username %></strong></td>
              <td><%= u.email || '-' %></td>
              <td>
                <% if (u.id === user.id) { %>
                  <span class="role-badge role-<%= u.role %>"><%= u.role %></span>
                <% } else { %>
                  <form action="/admin/users/<%= u.id %>/role" method="POST" class="role-form">
                    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                    <select name="role" class="theme-selector role-select autosubmit" aria-label="Role">
                      <option value="user" <%= u.role === 'user' ? 'selected' : '' %>>user</option>
                      <option value="gm" <%= u.role === 'gm' ? 'selected' : '' %>>gm</option>
                      <option value="admin" <%= u.role === 'admin' ? 'selected' : '' %>>admin</option>
                    </select>
                  </form>
                <% } %>
              </td>
              <td><% if (u.last_login) { %><span class="local-time" data-timestamp="<%= u.last_login %>" data-format="datetime"></span><% } else { %><span data-i18n="admin_never">Никогда</span><% } %></td>
              <td class="mono"><%= u.last_ip || '-' %></td>
              <td><span class="local-time" data-timestamp="<%= u.created_at %>" data-format="date"></span></td>
              <td class="actions-cell">
                <form action="/admin/users/<%= u.id %>/delete" method="POST" style="display:inline;" data-confirm="admin_confirm_delete_user" data-confirm-arg="<%= u.username %>?">
                  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                  <button type="submit" class="btn btn-xs btn-danger" data-i18n="delete">Удалить</button>
                </form>
              </td>
            </tr>
          <% }); %>
        </tbody>
      </table>
    </div>
  </div>
</section>

<%- include('../partials/footer') %>
