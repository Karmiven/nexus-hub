<%- include('partials/header') %>

<div class="scr-head">
  <div class="grow">
    <div class="scr-eyebrow">// <span data-i18n="srv_eyebrow">game servers</span></div>
    <h1 class="scr-title" data-i18n="game_servers">Game Servers</h1>
    <p class="scr-sub" data-i18n="servers_desc">Browse all our hosted game servers. Click on any server for more details.</p>
  </div>
</div>

<% if (servers.length === 0) { %>
  <div class="empty-state">
    <p data-i18n="no_servers">No servers configured yet. Check back soon!</p>
  </div>
<% } else { %>
  <div class="srv-grid">
    <% servers.forEach(function(srv) { %>
      <div class="panel server-card">
        <span class="panel-corner tl"></span><span class="panel-corner br"></span>
        <div class="srv-body">
          <div class="srv-row1">
            <div class="srv-ico">
              <% if (srv.image) { %><img src="<%= srv.image %>" alt="" loading="lazy" class="srv-img"><% } else { %><i data-lucide="gamepad-2"></i><% } %>
            </div>
            <div>
              <div class="srv-name"><%= srv.name %></div>
              <div class="srv-game"><%= srv.game %></div>
            </div>
            <span class="mbadge status-badge <%= srv.status === 'online' ? 'ok badge-online' : 'bad badge-offline' %>" data-i18n="<%= srv.status === 'online' ? 'online' : 'offline' %>"><%= srv.status === 'online' ? 'Online' : 'Offline' %></span>
          </div>
          <% if (srv.show_ip_address) { %>
            <div class="addr">
              <code><%= srv.ip %>:<%= srv.port %></code>
              <button type="button" class="addr-copy" data-i18n="copy">copy</button>
            </div>
          <% } %>
          <% if (srv.show_player_count) { %>
            <div class="pbar">
              <span><% if (srv.status === 'online') { %><%= srv.player_count %>/<%= srv.max_players %><% } else { %>—<% } %></span>
              <div class="bar"><div class="fill" style="width:<%= (srv.status === 'online' && srv.max_players > 0) ? Math.round(srv.player_count / srv.max_players * 100) : 0 %>%"></div></div>
            </div>
          <% } %>
          <% if (srv.description) { %>
            <p class="scr-sub" style="margin:0;"><%= srv.description.substring(0, 120) %></p>
          <% } %>
        </div>
        <div class="srv-foot">
          <span><span data-i18n="last_checked">Checked</span>: <span class="local-time" data-timestamp="<%= srv.last_checked %>" data-format="time"></span></span>
          <a href="/servers/<%= srv.id %>" class="btn-c">
            <span data-i18n="<%= (srv.redirect_enabled && srv.redirect_url) ? 'launch' : 'details' %>"><%= (srv.redirect_enabled && srv.redirect_url) ? 'Launch' : 'Details' %></span> <i data-lucide="arrow-right"></i>
          </a>
        </div>
      </div>
    <% }); %>
  </div>

  <script nonce="<%= cspNonce %>">
    document.querySelectorAll('.srv-img').forEach(function (img) {
      img.addEventListener('error', function () { img.remove(); });
    });
    document.querySelectorAll('.addr-copy').forEach(function (btn) {
      btn.addEventListener('click', function () {
        var code = btn.parentElement.querySelector('code');
        if (!code) return;
        if (navigator.clipboard) navigator.clipboard.writeText(code.textContent).catch(function () {});
        var original = btn.textContent;
        btn.textContent = 'ok ✓';
        setTimeout(function () { btn.textContent = original; }, 1400);
      });
    });
  </script>
<% } %>

<%- include('partials/footer') %>
