<%- include('partials/header') %>

<div class="scr-head">
  <div class="grow">
    <div class="scr-eyebrow">// <span data-i18n="chat_eyebrow">comms</span></div>
    <h1 class="scr-title" data-i18n="community_chat">Community Chat</h1>
    <p class="scr-sub" data-i18n="community_desc">Chat with other players in real-time. Be respectful!</p>
  </div>
</div>

<div class="chat-wrap2">
  <div class="panel">
    <span class="panel-corner tl"></span><span class="panel-corner br"></span>
    <div class="panel-head">#general <span class="right"><span class="tick-dot ok"></span> live</span></div>

    <div class="nick-bar" id="nicknameBar">
      <label for="nicknameInput" data-i18n="your_nickname">Your nickname:</label>
      <input type="text" id="nicknameInput" data-i18n-placeholder="enter_nickname" placeholder="Enter nickname..." maxlength="30" autocomplete="off"
        value="<%= user ? user.username : '' %>">
      <button type="button" id="nicknameBtn" class="btn-c" data-i18n="join_chat">Join Chat</button>
    </div>

    <% const isStaff = user && (user.role === 'admin' || user.role === 'gm'); %>
    <div class="chat-msgs2" id="chatMessages">
      <% messages.forEach(function(msg) { %>
        <div class="cmsg" data-id="<%= msg.id %>">
          <div class="h">
            <% if (msg.avatar) { %>
              <img src="<%= msg.avatar %>" alt="" class="cav">
            <% } else { %>
              <span class="cav cav-letter"><%= String(msg.username).charAt(0) %></span>
            <% } %>
            <span class="u <%= msg.role === 'admin' ? 'adm' : (msg.role === 'gm' ? 'gm' : '') %>"><%= msg.username %></span>
            <% if (msg.role === 'admin' || msg.role === 'gm') { %><span class="role-badge role-<%= msg.role %>"><%= msg.role %></span><% } %>
            <span class="tm local-time" data-timestamp="<%= msg.created_at %>" data-format="time"></span>
            <% if (isStaff) { %>
              <span class="modact">
                <button type="button" class="cmsg-mute" data-user="<%= msg.username %>" aria-label="Mute user" title="Mute">⊘</button>
                <button type="button" class="cmsg-del" aria-label="Delete message" title="Delete">✕</button>
              </span>
            <% } %>
          </div>
          <div class="tx"><%= msg.message %></div>
        </div>
      <% }); %>
    </div>

    <div class="chat-typing2" id="typingIndicator"></div>
    <form class="chat-in2" id="chatForm" style="display:none;">
      <input type="text" id="chatInput" data-i18n-placeholder="type_message" placeholder="Type a message..." maxlength="500" autocomplete="off">
      <button type="submit" class="btn-c" data-i18n="send">Send</button>
    </form>
  </div>

  <div class="panel">
    <span class="panel-corner tl"></span><span class="panel-corner br"></span>
    <div class="panel-head"><span data-i18n="online_users">Online</span> <span class="right" id="onlineCount">0</span></div>
    <div class="on-list2" id="onlineUsersList"></div>
  </div>
</div>

<script nonce="<%= cspNonce %>">document.body.classList.add('page-ready');</script>
<script nonce="<%= cspNonce %>" src="/socket.io/socket.io.js"></script>
<script nonce="<%= cspNonce %>">
  const socket = io();
  const IS_STAFF = <%= isStaff ? 'true' : 'false' %>;
  let username = '';
  const messagesDiv = document.getElementById('chatMessages');
  const chatForm = document.getElementById('chatForm');
  const chatInput = document.getElementById('chatInput');
  const typingIndicator = document.getElementById('typingIndicator');
  const nicknameBar = document.getElementById('nicknameBar');
  const nicknameInput = document.getElementById('nicknameInput');
  const nicknameBtn = document.getElementById('nicknameBtn');
  const onlineUsersList = document.getElementById('onlineUsersList');
  const onlineCount = document.getElementById('onlineCount');

  const savedNickname = localStorage.getItem('chat_nickname');
  if (savedNickname && !nicknameInput.value) {
    nicknameInput.value = savedNickname;
  }

  function scrollToBottom() {
    messagesDiv.scrollTop = messagesDiv.scrollHeight;
  }
  scrollToBottom();

  function joinChat() {
    const nick = nicknameInput.value.trim().replace(/[<>]/g, '');
    if (!nick) return;

    nicknameBtn.disabled = true;
    nicknameBtn.textContent = '...';

    socket.emit('chat:join', nick, (response) => {
      if (response.success) {
        username = response.username;
        localStorage.setItem('chat_nickname', username);
        nicknameBar.style.display = 'none';
        chatForm.style.display = 'flex';
        chatInput.focus();
      } else {
        showToast(response.error || (window.i18n ? window.i18n.t('chat_join_error') : 'Failed to join chat'), 'error');
        nicknameBtn.disabled = false;
        nicknameBtn.textContent = window.i18n ? window.i18n.t('join_chat') : 'Join Chat';
      }
    });
  }

  nicknameBtn.addEventListener('click', joinChat);
  nicknameInput.addEventListener('keydown', (e) => {
    if (e.key === 'Enter') joinChat();
  });

  if (savedNickname || nicknameInput.value) {
    joinChat();
  }

  socket.on('chat:online_users', (users) => {
    onlineCount.textContent = users.length;
    onlineUsersList.innerHTML = '';
    users.sort((a, b) => a.toLowerCase().localeCompare(b.toLowerCase()));
    users.forEach(user => {
      const row = document.createElement('div');
      const dot = document.createElement('span');
      dot.className = 'tick-dot ok';
      const name = document.createElement('span');
      name.textContent = user;
      if (user === username) {
        name.style.fontWeight = '700';
        name.style.color = 'var(--primary)';
      }
      row.appendChild(dot);
      row.appendChild(name);
      onlineUsersList.appendChild(row);
    });
  });

  function appendMessage(msg) {
    const div = document.createElement('div');
    div.className = 'cmsg';
    if (msg.id) div.dataset.id = msg.id;

    const head = document.createElement('div');
    head.className = 'h';
    if (msg.avatar && /^\/uploads\/avatars\//.test(msg.avatar)) {
      const av = document.createElement('img');
      av.className = 'cav';
      av.alt = '';
      av.src = msg.avatar;
      head.appendChild(av);
    } else {
      const av = document.createElement('span');
      av.className = 'cav cav-letter';
      av.textContent = (msg.username || '?').charAt(0);
      head.appendChild(av);
    }
    const userSpan = document.createElement('span');
    userSpan.className = 'u' + (msg.role === 'admin' ? ' adm' : (msg.role === 'gm' ? ' gm' : ''));
    userSpan.textContent = msg.username || '';
    head.appendChild(userSpan);
    if (msg.role === 'admin' || msg.role === 'gm') {
      const badge = document.createElement('span');
      badge.className = 'role-badge role-' + msg.role;
      badge.textContent = msg.role;
      head.appendChild(badge);
    }
    const timeSpan = document.createElement('span');
    timeSpan.className = 'tm local-time';
    timeSpan.setAttribute('data-timestamp', msg.created_at || '');
    timeSpan.setAttribute('data-format', 'time');
    head.appendChild(timeSpan);

    if (IS_STAFF) {
      const act = document.createElement('span');
      act.className = 'modact';
      const muteBtn = document.createElement('button');
      muteBtn.type = 'button';
      muteBtn.className = 'cmsg-mute';
      muteBtn.dataset.user = msg.username || '';
      muteBtn.title = 'Mute';
      muteBtn.setAttribute('aria-label', 'Mute user');
      muteBtn.textContent = '⊘';
      const delBtn = document.createElement('button');
      delBtn.type = 'button';
      delBtn.className = 'cmsg-del';
      delBtn.title = 'Delete';
      delBtn.setAttribute('aria-label', 'Delete message');
      delBtn.textContent = '✕';
      act.appendChild(muteBtn);
      act.appendChild(delBtn);
      head.appendChild(act);
    }

    const text = document.createElement('div');
    text.className = 'tx';
    text.textContent = msg.message || '';

    div.appendChild(head);
    div.appendChild(text);
    messagesDiv.appendChild(div);
    if (window.formatLocalTimes) window.formatLocalTimes();
    scrollToBottom();
  }

  socket.on('chat:message', appendMessage);

  // ── Moderation (admin / GM) ──
  socket.on('chat:deleted', (data) => {
    const el = messagesDiv.querySelector('.cmsg[data-id="' + parseInt(data.id) + '"]');
    if (el) el.remove();
  });

  if (IS_STAFF) {
    messagesDiv.addEventListener('click', (e) => {
      const delBtn = e.target.closest('.cmsg-del');
      const muteBtn = e.target.closest('.cmsg-mute');
      if (delBtn) {
        const card = delBtn.closest('.cmsg');
        if (!card || !card.dataset.id) return;
        socket.emit('chat:delete', parseInt(card.dataset.id), (res) => {
          if (!res.success) typingIndicator.textContent = res.error || 'Error';
        });
      } else if (muteBtn) {
        const target = muteBtn.dataset.user;
        if (!target || target === username) return;
        const raw = prompt((window.i18n ? window.i18n.t('chat_mute_prompt') : 'Mute for how many minutes?'), '10');
        if (raw === null) return;
        socket.emit('chat:mute', { username: target, minutes: parseInt(raw) || 10 }, (res) => {
          typingIndicator.textContent = res.success
            ? (target + ' muted for ' + res.minutes + ' min')
            : (res.error || 'Error');
        });
      }
    });
  }

  socket.on('chat:history', (messages) => {
    // History is already rendered server-side on full page load;
    // re-render only if the server list is empty (SPA navigation case)
    if (messagesDiv.children.length === 0 && Array.isArray(messages)) {
      messages.forEach(appendMessage);
    }
  });

  socket.on('chat:error', (msg) => {
    typingIndicator.textContent = msg;
  });

  let typingTimeout;
  socket.on('chat:typing', (data) => {
    typingIndicator.textContent = window.i18n ? window.i18n.t('is_typing', { user: data.username }) : data.username + ' is typing...';
    clearTimeout(typingTimeout);
    typingTimeout = setTimeout(() => {
      typingIndicator.textContent = '';
    }, 2000);
  });

  chatInput.addEventListener('input', () => {
    if (username) socket.emit('chat:typing', { username });
  });

  chatForm.addEventListener('submit', (e) => {
    e.preventDefault();
    const message = chatInput.value.trim();
    if (!message || !username) return;
    socket.emit('chat:message', { username, message });
    chatInput.value = '';
  });

  socket.on('disconnect', () => {
    onlineCount.textContent = '0';
    onlineUsersList.textContent = '';
  });

  socket.on('connect', () => {
    if (username) {
      socket.emit('chat:join', username, (response) => {
        if (!response.success) {
          username = '';
          localStorage.removeItem('chat_nickname');
          nicknameBar.style.display = 'flex';
          chatForm.style.display = 'none';
        }
      });
    }
  });
</script>

<%- include('partials/footer') %>
