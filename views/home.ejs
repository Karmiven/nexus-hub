<%- include('partials/header') %>

<div class="scr-head">
  <div class="grow">
    <div class="scr-eyebrow">// <span data-i18n="ov_eyebrow">main screen</span></div>
    <h1 class="scr-title" data-i18n="ov_title">Overview</h1>
    <p class="scr-sub"><%= heroSubtitle || '' %><% if (!heroSubtitle) { %><span data-i18n="ov_sub">Summary of every section. Details are one click away in the sidebar.</span><% } %></p>
  </div>
</div>

<div class="ov-grid">
  <div class="ov-stat hl">
    <div class="k" data-i18n="ov_players_now">Players now</div>
    <div class="v"><%= siteStats.players || 0 %></div>
  </div>
  <div class="ov-stat">
    <div class="k" data-i18n="ov_servers_online">Servers online</div>
    <div class="v"><%= siteStats.serversOnline || 0 %><em>/<%= siteStats.serversTotal || 0 %></em></div>
  </div>
  <div class="ov-stat">
    <div class="k" data-i18n="ov_uptime">Uptime 30d</div>
    <div class="v"><% if (siteStats.uptimePct !== null && siteStats.uptimePct !== undefined) { %><%= siteStats.uptimePct %><em>%</em><% } else { %>—<% } %></div>
  </div>
  <div class="ov-stat">
    <div class="k" data-i18n="ov_peak_24h">Peak online 24h</div>
    <div class="v"><%= peak24h %></div>
  </div>
</div>

<div class="ov-main">
  <div class="ov-col">
    <!-- Servers widget -->
    <div class="panel">
      <span class="panel-corner tl"></span><span class="panel-corner br"></span>
      <div class="panel-head"><span data-i18n="nav_servers">Servers</span> <span class="right">live</span></div>
      <% if (servers.length === 0) { %>
        <div class="mini-chat"><span class="mc-line" data-i18n="no_servers">No servers configured yet. Check back soon!</span></div>
      <% } else { %>
        <% servers.forEach(function(srv) { %>
          <div class="mini-srv">
            <div class="nm"><%= srv.name %>
              <span><% if (srv.show_ip_address) { %><%= srv.ip %>:<%= srv.port %><% } else { %><%= srv.game %><% } %></span>
            </div>
            <span class="pl"><% if (srv.status === 'online' && srv.show_player_count) { %><%= srv.player_count %>/<%= srv.max_players %><% } else { %>—<% } %></span>
            <span class="mbadge <%= srv.status === 'online' ? 'ok' : 'bad' %>" data-i18n="<%= srv.status === 'online' ? 'online' : 'offline' %>"><%= srv.status === 'online' ? 'Online' : 'Offline' %></span>
          </div>
        <% }); %>
      <% } %>
      <div class="panel-foot"><a href="/servers" class="link-m"><span data-i18n="ov_all_servers">All servers</span> →</a></div>
    </div>

    <!-- Chat widget -->
    <% if (communityEnabled) { %>
    <div class="panel">
      <span class="panel-corner tl"></span><span class="panel-corner br"></span>
      <div class="panel-head"><span data-i18n="ov_chat_head">Chat — #general</span></div>
      <div class="mini-chat">
        <% if (chatPreview.length === 0) { %>
          <span class="mc-line" data-i18n="ov_chat_empty">No messages yet — be the first!</span>
        <% } else { %>
          <% chatPreview.forEach(function(m) { %>
            <div class="mc-line">
              <span class="tm local-time" data-timestamp="<%= m.created_at %>" data-format="time"></span>
              <b class="<%= m.role === 'admin' ? 'adm' : (m.role === 'gm' ? 'gm' : '') %>"><%= m.username %></b> — <%= m.message %>
            </div>
          <% }); %>
        <% } %>
      </div>
      <div class="panel-foot"><a href="/community" class="link-m"><span data-i18n="ov_open_chat">Open chat</span> →</a></div>
    </div>
    <% } %>
  </div>

  <div class="ov-col">
    <!-- News widget -->
    <div class="panel">
      <span class="panel-corner tl"></span><span class="panel-corner br"></span>
      <div class="panel-head"><span data-i18n="nav_news">News</span></div>
      <% if (news.length === 0) { %>
        <div class="mini-chat"><span class="mc-line" data-i18n="no_news">No news yet. Check back soon!</span></div>
      <% } else { %>
        <% news.forEach(function(article) { %>
          <a class="mini-news" href="/news">
            <div class="t"><% if (article.pinned) { %><span class="pin">◆</span><% } %><%= pickField(article, 'title') %></div>
            <div class="m"><span class="local-time" data-timestamp="<%= article.created_at %>" data-format="date"></span><% if (article.pinned) { %> · <span data-i18n="pinned">Pinned</span><% } %></div>
          </a>
        <% }); %>
      <% } %>
      <div class="panel-foot"><a href="/news" class="link-m"><span data-i18n="ov_all_news">All news</span> →</a></div>
    </div>

    <!-- Infrastructure widget (loads only when monitoring is reachable) -->
    <div class="panel" id="ovMonPanel" hidden>
      <span class="panel-corner tl"></span><span class="panel-corner br"></span>
      <div class="panel-head"><span data-i18n="ov_infra">Infrastructure</span></div>
      <div class="mini-chat" id="ovMonBody" style="padding:14px 18px;"></div>
      <div class="panel-foot"><a href="/monitoring/dashboard" class="link-m"><span data-i18n="nav_monitoring">Monitoring</span> →</a></div>
    </div>
  </div>
</div>

<script nonce="<%= cspNonce %>">
// Overview infrastructure mini-widget: best-effort, hidden unless data is available
(function () {
  fetch('/monitoring/resources', { credentials: 'same-origin', headers: { 'Accept': 'application/json' } })
    .then(function (r) { return r.ok ? r.json() : null; })
    .then(function (data) {
      if (!data || !data.success || !data.guests || data.guests.length === 0) return;
      var body = document.getElementById('ovMonBody');
      var panel = document.getElementById('ovMonPanel');
      if (!body || !panel) return;
      body.textContent = '';
      data.guests.slice(0, 3).forEach(function (g) {
        var running = g.status === 'running';
        var cpu = Math.min(100, Math.max(0, g.cpu || 0));
        var meter = document.createElement('div');
        meter.className = 'meter';
        var mh = document.createElement('div');
        mh.className = 'mh';
        var name = document.createElement('span');
        name.textContent = (g.displayName || g.name) + ' · CPU';
        var val = document.createElement('b');
        val.textContent = running ? cpu.toFixed(0) + '%' : 'off';
        mh.appendChild(name); mh.appendChild(val);
        var mb = document.createElement('div');
        mb.className = 'mb';
        var mf = document.createElement('div');
        mf.className = 'mf' + (cpu > 75 ? ' hot' : '');
        mf.style.width = (running ? cpu : 0) + '%';
        mb.appendChild(mf);
        meter.appendChild(mh); meter.appendChild(mb);
        body.appendChild(meter);
      });
      panel.hidden = false;
    })
    .catch(function () { /* monitoring unavailable — keep hidden */ });
})();
</script>

<%- include('partials/footer') %>
